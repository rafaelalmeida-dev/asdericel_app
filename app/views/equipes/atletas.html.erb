<%= render "shared/context_nav", title: t("activerecord.models.equipe.other") do  %>
  <%= content_tag(:span, link_to(t("activerecord.models.equipe.other"), equipes_path, class: "text-dark"), class: "breadcrumb-item") %>
  <%= content_tag(:span, t("common.actions.#{params[:action]}"),class: "breadcrumb-item active")%>
<% end %>
<%= simple_form_for :equipes_path, url: atletas_equipe_path(@equipe), method: :post do |f| %>
  <!-- Área de notificações -->
  <%= render "shared/model_errors" %>
  <%= render "shared/notice" %>
  <!-- Card e formulário -->
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= translate_concat("common.actions.#{params[:action]}") %>
      </h5>
    </div>
    <div class="card-body"> 
      <form>
        <div class="row g-2 align-items-end">
          <div class="col-md-6">
            <select id="atleta-select" class="form-select select2">
              <option value="">Selecione um atleta</option>
              <% @atletas.each do |atleta| %>
                <option value="<%= atleta.id %>"
                  data-nome="<%= atleta.pessoa.nome %>"
                  data-cpf="<%= atleta.pessoa.cpf %>"
                  data-data-nascimento="<%= atleta.pessoa.datanascimento %>"
                  data-sexo="<%= atleta.pessoa.sexo %>">
                  <%= atleta.pessoa.nome %>
                </option>
              <% end %>
            </select>
          </div>
          <div class="col-md-2">
            <button type="button" id="btn-add-atleta" class="btn btn-primary" data-equipe-id="<%= @equipe.id %>">
              Adicionar Atleta
            </button>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped">
              <thead>
                <tr>
                  <th>Atleta</th>
                  <th>CPF</th>
                  <th>Data de Nascimento</th>
                  <th>Sexo</th>
                  <th>Ações</th>
                </tr>
              </thead>
            <tbody
              id="tabela-atletas"
              data-atletas='<%= raw(
                @equipe.atleta_equipes
                      .where(deleted_at: nil)
                      .includes(atleta: :pessoa)
                      .map { |ae|
                        atleta = ae.atleta
                        pessoa = atleta.pessoa

                        {
                          id: atleta.id,
                          atleta_equipe_id: ae.id,
                          nome: pessoa.nome,
                          cpf: pessoa.cpf,
                          data_nascimento: pessoa.datanascimento,
                          sexo: pessoa.sexo.nome
                        }
                      }.to_json
              ) %>'
            >
            </table>
          </div>
          <div id="lista-atleta" class="mt-3"></div>
        </div>
      </form>
    </div>
  </div>
<% end %>
<script>
  (() => {
    const atletas = [];
    function formatarData(data) {
      if (!data) return "";
      return new Date(data).toLocaleDateString("pt-BR");
    }
    function renderTabela() {
      const tbody = document.getElementById("tabela-atletas");
      if (!tbody) return;

      tbody.innerHTML = "";

      atletas.forEach((a, i) => {
        const tr = document.createElement("tr");

        tr.innerHTML = `
          <td>${a.nome}</td>
          <td>${a.cpf || "-"}</td>
          <td>${formatarData(a.data_nascimento)}</td>
          <td>${a.sexo || "-"}</td>
          <td class="text-center">
            ${window.isShowAction ? "" : `
              <button type="button" class="btn btn-danger btn-sm" data-index="${i}" data-atleta-equipe-id="${a.atleta_equipe_id}">
                Remover
              </button>
            `}
          </td>
        `;

        tbody.appendChild(tr);
      });

      // evento remover
      tbody.querySelectorAll("button[data-index]").forEach(btn => {
        btn.addEventListener("click", e => {
          const index = Number(e.currentTarget.dataset.index);
          const atletaEquipeId = e.currentTarget.dataset.atletaEquipeId;

          if (!atletaEquipeId) return;

          removerAtleta(atletaEquipeId, index);
        });
      });
    }
    async function removerAtleta(equipeId, index) {
      try {
        const response = await fetch(`/equipes/${equipeId}/remover_atleta`, {
          method: "DELETE",
          headers: {
            "X-CSRF-Token": document
              .querySelector("meta[name='csrf-token']")
              .getAttribute("content")
          }
        });

        const data = await response.json();

        if (!response.ok) {
          alert("Erro ao remover atleta");
          return;
        }

        // remove do array local
        atletas.splice(index, 1);
        renderTabela();

      } catch (error) {
        console.error(error);
        alert("Erro de comunicação");
      }
    }
    function renderHiddenFields() {
      document
        .querySelectorAll("input[name^='equipe[atletas]']")
        .forEach(e => e.remove());

      const form = document.querySelector("form");
      if (!form) return;

      atletas.forEach((a, i) => {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = `equipe[atletas][${i}][atleta_id]`;
        input.value = a.id;
        form.appendChild(input);
      });
    }
    function setupEventos() {
      const btnAdd = document.getElementById("btn-add-atleta");
      const select = document.getElementById("atleta-select");

      if (!btnAdd || !select) return;

    btnAdd.addEventListener("click", async () => {
      const atletaId = select.value;
      if (!atletaId) return;

      const equipeId = btnAdd.dataset.equipeId;

      // evita duplicado no front
      if (atletas.some(a => a.id == atletaId)) {
        alert("Atleta já adicionado");
        return;
      }

      try {
        const response = await fetch(`/equipes/${equipeId}/associar_atletas`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document
              .querySelector("meta[name='csrf-token']")
              .getAttribute("content")
          },
          body: JSON.stringify({
            atleta_id: atletaId
          })
        });

        const data = await response.json();

        if (!response.ok) {
          alert(data.error || "Erro ao associar atleta");
          return;
        }

        const option = select.options[select.selectedIndex];

        atletas.push({
          id: atletaId,
          atleta_equipe_id: data.atleta_equipe_id,
          nome: option.dataset.nome,
          cpf: option.dataset.cpf,
          data_nascimento: option.dataset.dataNascimento,
          sexo: option.dataset.sexo
        });

        renderTabela();

        select.value = "";
        $(select).trigger("change");

      } catch (error) {
        console.error(error);
        alert("Erro de comunicação com o servidor");
      }
    });
    }
    function carregarAtletasIniciais() {
      const container = document.getElementById("tabela-atletas");
      if (!container) return;

      const data = container.dataset.atletas;
      if (!data) return;

      try {
        JSON.parse(data).forEach(a => atletas.push(a));
        renderTabela();
        renderHiddenFields();
      } catch (e) {
        console.error("Erro ao carregar atletas iniciais", e);
      }
    }

    document.addEventListener("turbo:load", () => {
      setupEventos();
      carregarAtletasIniciais();
    });

    document.addEventListener("DOMContentLoaded", () => {
      setupEventos();
      carregarAtletasIniciais();
    });
  })();
</script>
