<style>
  /* Card do atleta */
.atleta-card {
  background-color: #f1f5f9;           /* cinza claro (alto contraste) */
  border: 1px solid #cbd5e1;            /* borda visível */
  border-left: 6px solid #0d6efd;       /* destaque visual */
  border-radius: 0.75rem;
  padding: 0.75rem 1rem;
  margin-bottom: 0.75rem;
  transition: all 0.2s ease;
}

/* Hover */
.atleta-card:hover {
  background-color: #e9f2ff;
  transform: translateX(2px);
}

/* Nome */
.atleta-nome {
  font-weight: 600;
  color: #1e293b;
}

/* Ícone */
.atleta-icon {
  font-size: 1.2rem;
  color: #0d6efd;
}

/* Botão remover */
.atleta-card .btn-remover {
  color: #dc3545;
  border: none;
  background: transparent;
}

.atleta-card .btn-remover:hover {
  color: #fff;
  background-color: #dc3545;
}

</style>

<%= render "shared/context_nav", title: t("activerecord.models.equipe.other") do  %>
  <%= content_tag(:span, link_to(t("activerecord.models.equipe.other"), equipes_path, class: "text-dark"), class: "breadcrumb-item") %>
  <%= content_tag(:span, t("common.actions.#{params[:action]}"),class: "breadcrumb-item active")%>
<% end %>
<%= simple_form_for :equipes_path, url: atletas_equipe_path(@equipe), method: :post do |f| %>
  <!-- Área de notificações -->
  <%= render "shared/model_errors" %>
  <%= render "shared/notice" %>
  <!-- Card e formulário -->
  <div class="card">
    <div class="card-header">
      <h5 class="my-0">
        <%= translate_concat("common.actions.#{params[:action]}") %>
      </h5>
    </div>
    <div class="card-body"> 
      <form>
        <div class="row g-2 align-items-end">
          <div class="col-md-6">
            <%= select_tag "atleta_select",
              options_from_collection_for_select(@atletas, :id, :to_s),
              prompt: "Selecione um atleta",
              class: "form-select select2",
              id: "atleta-select" %>
          </div>

          <div class="col-md-2">
            <button type="button" id="btn-add-atleta" class="btn btn-primary">
              Adicionar
            </button>
          </div>

          <div id="lista-atleta" class="mt-3"></div>
        </div>
      </form>
    </div>
  </div>
<% end %>



<script>
  (() => {
    const atletasSelecionados = new Set();

    function renderAtleta(id, nome) {
      const container = document.getElementById("lista-atleta");

      const div = document.createElement("div");
      div.className = "d-flex align-items-center gap-2 mb-2 atleta-item";
      div.dataset.id = id;

    div.innerHTML = `
      <input type="hidden" name="registros[atletas_ids][]" value="${id}">

      <div class="atleta-card d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-person-fill atleta-icon"></i>
          <span class="atleta-nome">${nome}</span>
        </div>

        <button type="button"
                class="btn btn-sm btn-remover m-1"
                title="Remover atleta">
          <i class="ph ph-x"></i>
        </button>
      </div>
    `;


      container.appendChild(div);
    }

    function setupEventos() {
      document.getElementById("btn-add-atleta")?.addEventListener("click", () => {
        const select = document.getElementById("atleta-select");
        const id = select.value;
        const nome = select.options[select.selectedIndex]?.text;

        if (!id || atletasSelecionados.has(id)) return;

        atletasSelecionados.add(id);
        renderAtleta(id, nome);

        select.value = "";
        select.dispatchEvent(new Event("change"));
      });

      document.addEventListener("click", e => {
        if (!e.target.classList.contains("btn-remover")) return;

        const item = e.target.closest(".atleta-item");
        atletasSelecionados.delete(item.dataset.id);
        item.remove();
      });
    }

    document.addEventListener("turbo:load", setupEventos);
    document.addEventListener("DOMContentLoaded", setupEventos);
  })();
</script>

